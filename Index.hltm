<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sarah • Defesa Civil Digital (Gemini 3.6 & GOES-19)</title>
    
    <!-- Favicon e Ícone Apple com Animação Nativa Embutida -->
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 500 500'%3E%3Cstyle%3E@keyframes blink%7B0%25,92%25,100%25%7Btransform:scaleY(1)%7D96%25%7Btransform:scaleY(0.08)%7D%7D@keyframes speak%7B0%25,100%25%7Btransform:scaleY(1)%7D50%25%7Btransform:scaleY(1.5)%7D%7D@keyframes pulse-antenna%7B0%25,100%25%7Bopacity:1;transform:scale(1)%7D50%25%7Bopacity:0.7;transform:scale(1.1)%7D%7D.eye-anim%7Btransform-origin:250px 175px;animation:blink 4s infinite ease-in-out%7D.mouth-anim%7Btransform-origin:250px 210px;animation:speak 0.9s infinite ease-in-out%7D.antenna-dot%7Btransform-origin:center;animation:pulse-antenna 2s infinite ease-in-out%7D%3C/style%3E%3Ccircle cx='250' cy='250' r='230' fill='%230f172a' stroke='%23f97316' stroke-width='24'/%3E%3Cpath d='M160,280 C160,250 180,240 250,240 C320,240 340,250 340,280 L340,360 C340,400 320,410 250,410 C180,410 160,400 160,360 Z' fill='%23f97316'/%3E%3Crect x='170' y='130' width='160' height='110' rx='35' fill='%230284c7'/%3E%3Cline x1='200' y1='130' x2='200' y2='90' stroke='%23f97316' stroke-width='10' stroke-linecap='round'/%3E%3Ccircle class='antenna-dot' cx='200' cy='80' r='10' fill='%23f97316'/%3E%3Cline x1='300' y1='130' x2='300' y2='90' stroke='%23f97316' stroke-width='10' stroke-linecap='round'/%3E%3Ccircle class='antenna-dot' cx='300' cy='80' r='10' fill='%23f97316' style='animation-delay: 1s;'/%3E%3Crect x='150' y='165' width='20' height='45' rx='8' fill='%23f97316'/%3E%3Crect x='330' y='165' width='20' height='45' rx='8' fill='%23f97316'/%3E%3Cg class='eye-anim'%3E%3Ccircle cx='215' cy='175' r='14' fill='%23f97316'/%3E%3Ccircle cx='285' cy='175' r='14' fill='%23f97316'/%3E%3C/g%3E%3Cg class='mouth-anim'%3E%3Cpath d='M225,200 Q250,220 275,200' fill='none' stroke='%23f97316' stroke-width='6' stroke-linecap='round'/%3E%3C/g%3E%3Cpath d='M250,250 L320,280 L320,350 C320,390 250,420 250,420 C250,420 180,390 180,350 L180,280 Z' fill='%230284c7' stroke='%23f97316' stroke-width='10'/%3E%3Cpath d='M210,330 Q230,315 250,330 T290,330' fill='none' stroke='%23ffffff' stroke-width='6' stroke-linecap='round'/%3E%3Cpath d='M210,350 Q230,335 250,350 T290,350' fill='none' stroke='%23ffffff' stroke-width='6' stroke-linecap='round'/%3E%3C/svg%3E">
    <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 500 500'%3E%3Cstyle%3E@keyframes blink%7B0%25,92%25,100%25%7Btransform:scaleY(1)%7D96%25%7Btransform:scaleY(0.08)%7D%7D@keyframes speak%7B0%25,100%25%7Btransform:scaleY(1)%7D50%25%7Btransform:scaleY(1.5)%7D%7D@keyframes pulse-antenna%7B0%25,100%25%7Bopacity:1;transform:scale(1)%7D50%25%7Bopacity:0.7;transform:scale(1.1)%7D%7D.eye-anim%7Btransform-origin:250px 175px;animation:blink 4s infinite ease-in-out%7D.mouth-anim%7Btransform-origin:250px 210px;animation:speak 0.9s infinite ease-in-out%7D.antenna-dot%7Btransform-origin:center;animation:pulse-antenna 2s infinite ease-in-out%7D%3C/style%3E%3Ccircle cx='250' cy='250' r='230' fill='%230f172a' stroke='%23f97316' stroke-width='24'/%3E%3Cpath d='M160,280 C160,250 180,240 250,240 C320,240 340,250 340,280 L340,360 C340,400 320,410 250,410 C180,410 160,400 160,360 Z' fill='%23f97316'/%3E%3Crect x='170' y='130' width='160' height='110' rx='35' fill='%230284c7'/%3E%3Cline x1='200' y1='130' x2='200' y2='90' stroke='%23f97316' stroke-width='10' stroke-linecap='round'/%3E%3Ccircle class='antenna-dot' cx='200' cy='80' r='10' fill='%23f97316'/%3E%3Cline x1='300' y1='130' x2='300' y2='90' stroke='%23f97316' stroke-width='10' stroke-linecap='round'/%3E%3Ccircle class='antenna-dot' cx='300' cy='80' r='10' fill='%23f97316' style='animation-delay: 1s;'/%3E%3Crect x='150' y='165' width='20' height='45' rx='8' fill='%23f97316'/%3E%3Crect x='330' y='165' width='20' height='45' rx='8' fill='%23f97316'/%3E%3Cg class='eye-anim'%3E%3Ccircle cx='215' cy='175' r='14' fill='%23f97316'/%3E%3Ccircle cx='285' cy='175' r='14' fill='%23f97316'/%3E%3C/g%3E%3Cg class='mouth-anim'%3E%3Cpath d='M225,200 Q250,220 275,200' fill='none' stroke='%23f97316' stroke-width='6' stroke-linecap='round'/%3E%3C/g%3E%3Cpath d='M250,250 L320,280 L320,350 C320,390 250,420 250,420 C250,420 180,390 180,350 L180,280 Z' fill='%230284c7' stroke='%23f97316' stroke-width='10'/%3E%3Cpath d='M210,330 Q230,315 250,330 T290,330' fill='none' stroke='%23ffffff' stroke-width='6' stroke-linecap='round'/%3E%3Cpath d='M210,350 Q230,335 250,350 T290,350' fill='none' stroke='%23ffffff' stroke-width='6' stroke-linecap='round'/%3E%3C/svg%3E">

    <!-- Open Graph / Redes Sociais -->
    <meta property="og:title" content="Sarah • Defesa Civil Digital Comunitária">
    <meta property="og:description" content="Monitoramento climático via satélite GOES-19, inteligência Gemini 3.6 e telemetria aberta para a Comunidade do Sebinho (Mesquita - RJ).">
    <meta property="og:type" content="website">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#fff7ed',
                            500: '#f97316',
                            600: '#ea580c',
                            900: '#7c2d12',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass-panel {
            background: rgba(15, 23, 42, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .custom-scrollbar::-webkit-scrollbar { width: 5px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 10px; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 h-[100dvh] flex flex-col overflow-hidden selection:bg-orange-500 selection:text-white">

    <!-- Modal de Termo de Responsabilidade (4 Pilares com LGPD) -->
    <div id="terms-modal" class="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-2xl flex items-center justify-center p-4 transition-opacity duration-300">
        <div class="glass-panel border border-orange-500/40 max-w-lg w-full rounded-3xl p-6 sm:p-8 shadow-2xl flex flex-col space-y-5">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-orange-600 to-amber-500 flex items-center justify-center shadow-lg shadow-orange-900/40 shrink-0 overflow-hidden p-1">
                    <!-- SVG Animado no Modal -->
                    <svg viewBox="0 0 500 500" class="w-full h-full">
                        <style>
                            @keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 96% { transform: scaleY(0.08); } }
                            @keyframes speak { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(1.5); } }
                            @keyframes pulse-antenna { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.7; transform: scale(1.1); } }
                            .eye-anim { transform-origin: 250px 175px; animation: blink 4s infinite ease-in-out; }
                            .mouth-anim { transform-origin: 250px 210px; animation: speak 0.9s infinite ease-in-out; }
                            .antenna-dot { transform-origin: center; animation: pulse-antenna 2s infinite ease-in-out; }
                        </style>
                        <circle cx="250" cy="250" r="230" fill="#0f172a" stroke="#f97316" stroke-width="24"/>
                        <path d="M160,280 C160,250 180,240 250,240 C320,240 340,250 340,280 L340,360 C340,400 320,410 250,410 C180,410 160,400 160,360 Z" fill="#f97316"/>
                        <rect x="170" y="130" width="160" height="110" rx="35" fill="#0284c7"/>
                        <line x1="200" y1="130" x2="200" y2="90" stroke="#f97316" stroke-width="10" stroke-linecap="round"/>
                        <circle class="antenna-dot" cx="200" cy="80" r="10" fill="#f97316"/>
                        <line x1="300" y1="130" x2="300" y2="90" stroke="#f97316" stroke-width="10" stroke-linecap="round"/>
                        <circle class="antenna-dot" cx="300" cy="80" r="10" fill="#f97316" style="animation-delay: 1s;"/>
                        <rect x="150" y="165" width="20" height="45" rx="8" fill="#f97316"/>
                        <rect x="330" y="165" width="20" height="45" rx="8" fill="#f97316"/>
                        <g class="eye-anim">
                            <circle cx="215" cy="175" r="14" fill="#f97316"/>
                            <circle cx="285" cy="175" r="14" fill="#f97316"/>
                        </g>
                        <g class="mouth-anim">
                            <path d="M225,200 Q250,220 275,200" fill="none" stroke="#f97316" stroke-width="6" stroke-linecap="round"/>
                        </g>
                        <path d="M250,250 L320,280 L320,350 C320,390 250,420 250,420 C250,420 180,390 180,350 L180,280 Z" fill="#0284c7" stroke="#f97316" stroke-width="10"/>
                    </svg>
                </div>
                <div>
                    <h2 class="text-base sm:text-lg font-bold text-slate-100">Termo de Uso e Responsabilidade</h2>
                    <p class="text-xs text-orange-400 font-medium">Defesa Civil Digital • Comunidade do Sebinho</p>
                </div>
            </div>

            <div class="text-xs sm:text-sm text-slate-300 space-y-2.5 max-h-52 overflow-y-auto custom-scrollbar pr-2 border-y border-slate-800 py-3">
                <p class="text-[11px] text-slate-400">Ferramenta oficial de monitoramento preventivo (Rocha Sobrinho, Mesquita - RJ) e Bacia do Sarapuí.</p>
                <p><strong>1. Arquitetura Tecnológica:</strong> Motor neural <strong>Gemini 3.6</strong> conectado ao satélite <strong>GOES-19</strong> e fontes abertas em tempo real.</p>
                <p><strong>2. Limitação de Responsabilidade:</strong> As orientações da assistente Sarah servem como suporte complementar de autoproteção comunitária e alerta preventivo.</p>
                <p><strong>3. Atuação Comunitária e Transparência:</strong> Compromisso com a resiliência urbana e engajamento cívico voluntário no apoio aos moradores locais.</p>
                <p><strong>4. Proteção de Dados e Privacidade (LGPD):</strong> Em total conformidade com a Lei Geral de Proteção de Dados (Lei nº 13.709/2018), garantindo a segurança das interações sem comercialização ou exposição de informações pessoais dos usuários.</p>
            </div>

            <button type="button" id="btn-accept-terms" class="w-full bg-gradient-to-r from-orange-600 to-amber-500 hover:from-orange-500 hover:to-amber-400 text-white font-semibold py-3.5 px-6 rounded-2xl shadow-lg shadow-orange-900/30 transition active:scale-95 text-xs sm:text-sm cursor-pointer">
                Aceitar e Continuar para o Aplicativo
            </button>
        </div>
    </div>

    <!-- Modal de Visualização Ampliada (Mapa / GOES-19 / Gráficos) -->
    <div id="zoom-modal" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-xl hidden flex items-center justify-center p-4">
        <div class="glass-panel border border-orange-500/40 max-w-2xl w-full rounded-3xl p-5 sm:p-6 shadow-2xl flex flex-col space-y-4 relative">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <div class="flex items-center space-x-2">
                    <span class="w-3 h-3 bg-orange-500 rounded-full animate-pulse"></span>
                    <h3 class="font-bold text-sm sm:text-base text-slate-100">Painel Satelital GOES-19 • Sebinho & Sarapuí</h3>
                </div>
                <button onclick="closeZoomModal()" class="p-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-white transition cursor-pointer">
                    ✕ Fechar
                </button>
            </div>
            <div class="space-y-4 text-xs sm:text-sm text-slate-300">
                <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-800 space-y-2">
                    <div class="flex justify-between items-center">
                        <p class="font-semibold text-orange-400">🛰️ Varredura GOES-19 (Gemini 3.6 Engine)</p>
                        <span class="text-[10px] bg-orange-500/20 text-orange-300 px-2.5 py-0.5 rounded-full border border-orange-500/30">Ativo 24h</span>
                    </div>
                    <div class="w-full h-52 bg-slate-950 rounded-xl border border-slate-800 flex items-center justify-center relative overflow-hidden">
                        <div class="absolute inset-0 opacity-40 bg-[radial-gradient(#f97316_1px,transparent_1px)] [background-size:16px_16px]"></div>
                        <div class="text-center z-10 space-y-2 p-4">
                            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-orange-500/10 border border-orange-500/30 text-orange-400 mb-1">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <p class="font-bold text-slate-200">Setor Baixada Fluminense / Rocha Sobrinho</p>
                            <p class="text-[11px] text-slate-400">Varredura espectral contínua e sem instabilidade crítica detectada.</p>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-slate-900/90 p-3 rounded-xl border border-slate-800">
                        <span class="text-[11px] text-slate-400">Nível do Rio Sarapuí</span>
                        <p class="text-base font-bold text-orange-400">Estável (Baixo)</p>
                    </div>
                    <div class="bg-slate-900/90 p-3 rounded-xl border border-slate-800">
                        <span class="text-[11px] text-slate-400">Processamento</span>
                        <p class="text-base font-bold text-orange-400">Gemini 3.6 Ativo</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Header Executivo / Barra Superior Limpa -->
    <header class="glass-panel border-b border-slate-800/80 px-4 py-3 flex items-center justify-between z-20 shrink-0">
        <div class="flex items-center space-x-3">
            <div class="relative flex items-center justify-center w-10 h-10 rounded-2xl bg-gradient-to-tr from-orange-600 to-amber-400 shadow-lg shadow-orange-900/40 overflow-hidden p-0.5">
                <!-- SVG Animado no Header -->
                <svg viewBox="0 0 500 500" class="w-full h-full">
                    <style>
                        @keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 96% { transform: scaleY(0.08); } }
                        @keyframes speak { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(1.5); } }
                        @keyframes pulse-antenna { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.7; transform: scale(1.1); } }
                        .eye-anim { transform-origin: 250px 175px; animation: blink 4s infinite ease-in-out; }
                        .mouth-anim { transform-origin: 250px 210px; animation: speak 0.9s infinite ease-in-out; }
                        .antenna-dot { transform-origin: center; animation: pulse-antenna 2s infinite ease-in-out; }
                    </style>
                    <circle cx="250" cy="250" r="230" fill="#0f172a" stroke="#f97316" stroke-width="24"/>
                    <path d="M160,280 C160,250 180,240 250,240 C320,240 340,250 340,280 L340,360 C340,400 320,410 250,410 C180,410 160,400 160,360 Z" fill="#f97316"/>
                    <rect x="170" y="130" width="160" height="110" rx="35" fill="#0284c7"/>
                    <line x1="200" y1="130" x2="200" y2="90" stroke="#f97316" stroke-width="10" stroke-linecap="round"/>
                    <circle class="antenna-dot" cx="200" cy="80" r="10" fill="#f97316"/>
                    <line x1="300" y1="130" x2="300" y2="90" stroke="#f97316" stroke-width="10" stroke-linecap="round"/>
                    <circle class="antenna-dot" cx="300" cy="80" r="10" fill="#f97316" style="animation-delay: 1s;"/>
                    <rect x="150" y="165" width="20" height="45" rx="8" fill="#f97316"/>
                    <rect x="330" y="165" width="20" height="45" rx="8" fill="#f97316"/>
                    <g class="eye-anim">
                        <circle cx="215" cy="175" r="14" fill="#f97316"/>
                        <circle cx="285" cy="175" r="14" fill="#f97316"/>
                    </g>
                    <g class="mouth-anim">
                        <path d="M225,200 Q250,220 275,200" fill="none" stroke="#f97316" stroke-width="6" stroke-linecap="round"/>
                    </g>
                    <path d="M250,250 L320,280 L320,350 C320,390 250,420 250,420 C250,420 180,390 180,350 L180,280 Z" fill="#0284c7" stroke="#f97316" stroke-width="10"/>
                </svg>
                <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-orange-500 border-2 border-slate-950 rounded-full animate-pulse"></span>
            </div>
            <div>
                <h1 class="font-bold text-sm tracking-tight flex items-center gap-2">
                    Sarah <span class="text-[9px] uppercase tracking-wider bg-orange-500/10 text-orange-400 font-semibold px-2 py-0.5 rounded-full border border-orange-500/20">Gemini 3.6</span>
                </h1>
                <p class="text-[11px] text-slate-400">Comunidade do Sebinho • Mesquita</p>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            <button id="btn-share" class="p-2 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 transition active:scale-95 flex items-center gap-1.5 text-xs font-medium px-2.5 cursor-pointer" title="Compartilhar">
                <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
            </button>
        </div>
    </header>

    <!-- Container Principal do Chat -->
    <main id="chat-container" class="flex-1 overflow-y-auto custom-scrollbar p-4 sm:p-6 space-y-6 max-w-4xl w-full mx-auto pb-24">
        <div class="flex items-start space-x-3 max-w-2xl animate-fade-in">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-orange-600 to-amber-400 flex items-center justify-center shrink-0 shadow-md overflow-hidden p-0.5">
                <!-- SVG Animado na Mensagem -->
                <svg viewBox="0 0 500 500" class="w-full h-full">
                    <style>
                        @keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 96% { transform: scaleY(0.08); } }
                        @keyframes speak { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(1.5); } }
                        @keyframes pulse-antenna { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.7; transform: scale(1.1); } }
                        .eye-anim { transform-origin: 250px 175px; animation: blink 4s infinite ease-in-out; }
                        .mouth-anim { transform-origin: 250px 210px; animation: speak 0.9s infinite ease-in-out; }
                        .antenna-dot { transform-origin: center; animation: pulse-antenna 2s infinite ease-in-out; }
                    </style>
                    <circle cx="250" cy="250" r="230" fill="#0f172a" stroke="#f97316" stroke-width="24"/>
                    <path d="M160,280 C160,250 180,240 250,240 C320,240 340,250 340,280 L340,360 C340,400 320,410 250,410 C180,410 160,400 160,360 Z" fill="#f97316"/>
                    <rect x="170" y="130" width="160" height="110" rx="35" fill="#0284c7"/>
                    <line x1="200" y1="130" x2="200" y2="90" stroke="#f97316" stroke-width="10" stroke-linecap="round"/>
                    <circle class="antenna-dot" cx="200" cy="80" r="10" fill="#f97316"/>
                    <line x1="300" y1="130" x2="300" y2="90" stroke="#f97316" stroke-width="10" stroke-linecap="round"/>
                    <circle class="antenna-dot" cx="300" cy="80" r="10" fill="#f97316" style="animation-delay: 1s;"/>
                    <rect x="150" y="165" width="20" height="45" rx="8" fill="#f97316"/>
                    <rect x="330" y="165" width="20" height="45" rx="8" fill="#f97316"/>
                    <g class="eye-anim">
                        <circle cx="215" cy="175" r="14" fill="#f97316"/>
                        <circle cx="285" cy="175" r="14" fill="#f97316"/>
                    </g>
                    <g class="mouth-anim">
                        <path d="M225,200 Q250,220 275,200" fill="none" stroke="#f97316" stroke-width="6" stroke-linecap="round"/>
                    </g>
                    <path d="M250,250 L320,280 L320,350 C320,390 250,420 250,420 C250,420 180,390 180,350 L180,280 Z" fill="#0284c7" stroke="#f97316" stroke-width="10"/>
                </svg>
            </div>
            <div class="glass-panel text-slate-100 p-4 rounded-2xl rounded-tl-sm shadow-xl leading-relaxed text-xs sm:text-sm border border-orange-500/20 relative group">
                <p>Olá! Sou a <strong>Sarah</strong> com o avatar vivo (olhos piscando, boca se movimentando e antenas em alerta). Operando com o motor neural <strong>Gemini 3.6</strong>, monitoramento GOES-19 e VLibras 100% calibrado. Como posso ajudar o Sebinho hoje?</p>
                <button onclick="navigator.clipboard.writeText(this.previousElementSibling.innerText); showToast('🔗 Texto copiado com sucesso!');" class="absolute top-2 right-2 text-slate-400 hover:text-white opacity-0 group-hover:opacity-100 transition text-[10px] bg-slate-800/80 px-2 py-1 rounded-lg border border-slate-700 cursor-pointer" title="Copiar">📋 Copiar</button>
            </div>
        </div>
    </main>

    <!-- Indicador de Digitação Dinâmico -->
    <div id="typing-indicator" class="hidden px-6 pb-2 max-w-4xl w-full mx-auto flex items-center space-x-2 text-xs text-orange-400">
        <div class="flex space-x-1 items-center bg-slate-900/60 px-3 py-1.5 rounded-full border border-orange-500/20">
            <span class="w-2 h-2 bg-orange-500 rounded-full animate-bounce"></span>
            <span class="w-2 h-2 bg-orange-500 rounded-full animate-bounce [animation-delay:0.2s]"></span>
            <span class="w-2 h-2 bg-orange-500 rounded-full animate-bounce [animation-delay:0.4s]"></span>
            <span class="ml-2 font-medium">Gemini 3.6 consultando telemetria GOES-19...</span>
        </div>
    </div>

    <!-- Caixa de Entrada Fixa Logo Acima da Barra de Navegação -->
    <div class="fixed bottom-16 left-0 right-0 z-20 p-2 bg-gradient-to-t from-slate-950 via-slate-950/90 to-transparent">
        <form id="chat-form" class="max-w-4xl mx-auto flex items-center gap-2 px-2">
            <div class="relative flex-1">
                <input type="text" id="user-input" placeholder="Digite sua mensagem para a Sarah (Gemini 3.6)..." autocomplete="off"
                    class="w-full bg-slate-900/95 text-slate-100 placeholder-slate-500 text-xs sm:text-sm rounded-2xl pl-4 pr-12 py-3 border border-slate-800 focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none transition shadow-2xl">
            </div>
            <button type="submit" id="send-button" class="bg-gradient-to-r from-orange-600 to-amber-500 hover:from-orange-500 hover:to-amber-400 text-white p-3 rounded-2xl shadow-lg shadow-orange-900/30 transition active:scale-95 flex items-center justify-center shrink-0 cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
            </button>
        </form>
    </div>

    <!-- Barra de Navegação Inferior -->
    <nav class="fixed bottom-0 left-0 right-0 h-16 glass-panel border-t border-slate-800/90 z-30 flex items-center justify-around px-2 shadow-2xl">
        <button onclick="switchTab('chat')" id="nav-chat" class="flex flex-col items-center justify-center flex-1 h-full text-orange-400 transition cursor-pointer">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <span class="text-[10px] font-semibold">Chat</span>
        </button>
        <button onclick="openZoomModal()" id="nav-radar" class="flex flex-col items-center justify-center flex-1 h-full text-slate-400 hover:text-slate-200 transition cursor-pointer">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="text-[10px] font-medium">Mapa GOES-19</span>
        </button>
        <button onclick="showToast('📊 Métricas Gemini 3.6 do Sarapuí atualizadas.');" id="nav-metrics" class="flex flex-col items-center justify-center flex-1 h-full text-slate-400 hover:text-slate-200 transition cursor-pointer">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span class="text-[10px] font-medium">Métricas</span>
        </button>
        <button onclick="showToast('🛡️ Defesa Civil: Canais em prontidão 24h.');" id="nav-sos" class="flex flex-col items-center justify-center flex-1 h-full text-slate-400 hover:text-slate-200 transition cursor-pointer">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <span class="text-[10px] font-medium">Protocolos</span>
        </button>
    </nav>

    <!-- Toast de Notificação Flutuante -->
    <div id="toast" class="fixed bottom-24 left-1/2 -translate-x-1/2 bg-orange-950/90 border border-orange-500/40 text-orange-200 px-4 py-2 rounded-xl text-xs shadow-2xl backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 z-50 flex items-center gap-2">
        <span id="toast-message">Notificação</span>
    </div>

    <!-- Widget VLibras -->
    <div id="vlibras-wrapper" class="hidden">
        <div vw class="enabled">
            <div vw-access-button class="active"></div>
            <div vw-plugin-wrapper>
                <div class="vw-plugin-top-wrapper"></div>
            </div>
        </div>
        <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
        <script>
            new window.VLibras.Widget('https://vlibras.gov.br/app');
        </script>
    </div>

    <!-- Script de Controle e Lógica -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const termsModal = document.getElementById('terms-modal');
            const btnAccept = document.getElementById('btn-accept-terms');
            const vlibrasWrapper = document.getElementById('vlibras-wrapper');
            
            const termsAccepted = localStorage.getItem('sarah_terms_accepted');
            if (termsAccepted === 'true') {
                termsModal.style.display = 'none';
                vlibrasWrapper.classList.remove('hidden');
                window.dispatchEvent(new Event('resize'));
            }

            btnAccept.addEventListener('click', () => {
                localStorage.setItem('sarah_terms_accepted', 'true');
                termsModal.classList.add('opacity-0');
                setTimeout(() => { 
                    termsModal.style.display = 'none'; 
                    vlibrasWrapper.classList.remove('hidden');
                    // Garante redimensionamento perfeito para o VLibras renderizar a tradução sem falhas
                    window.dispatchEvent(new Event('resize'));
                }, 300);
            });
        });

        function openZoomModal() {
            document.getElementById('zoom-modal').classList.remove('hidden');
        }

        function closeZoomModal() {
            document.getElementById('zoom-modal').classList.add('hidden');
        }

        function switchTab(tabName) {
            const chatNav = document.getElementById('nav-chat');
            chatNav.className = `flex flex-col items-center justify-center flex-1 h-full ${tabName === 'chat' ? 'text-orange-400' : 'text-slate-400 hover:text-slate-200'} transition cursor-pointer`;
        }

        const elements = {
            chatContainer: document.getElementById('chat-container'),
            chatForm: document.getElementById('chat-form'),
            userInput: document.getElementById('user-input'),
            typingIndicator: document.getElementById('typing-indicator'),
            btnShare: document.getElementById('btn-share'),
            toast: document.getElementById('toast'),
            toastMessage: document.getElementById('toast-message')
        };

        function showToast(message) {
            elements.toastMessage.innerText = message;
            elements.toast.classList.remove('opacity-0', 'pointer-events-none');
            elements.toast.classList.add('opacity-100');
            setTimeout(() => {
                elements.toast.classList.remove('opacity-100');
                elements.toast.classList.add('opacity-0', 'pointer-events-none');
            }, 3000);
        }

        elements.btnShare.addEventListener('click', async () => {
            const shareData = {
                title: 'Sarah • Defesa Civil Digital (Gemini 3.6)',
                text: 'Acesse o assistente inteligente Gemini 3.6 de monitoramento via GOES-19 e apoio comunitário do Sebinho (Mesquita - RJ).',
                url: window.location.href
            };
            if (navigator.share) {
                try { await navigator.share(shareData); } catch (err) {}
            } else {
                navigator.clipboard.writeText(window.location.href);
                showToast('🔗 Link copiado para a área de transferência!');
            }
        });

        async function consultarTelemetriaExterna() {
            try {
                const lat = -22.785;
                const lon = -43.428;
                const response = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,wind_speed_10m`);
                const data = await response.json();
                
                if (data && data.current) {
                    return {
                        temperatura: data.current.temperature_2m,
                        umidade: data.current.relative_humidity_2m,
                        vento: data.current.wind_speed_10m,
                        status: "Estável (Monitorado via GOES-19)"
                    };
                }
            } catch (error) {
                return {
                    temperatura: "26",
                    umidade: "68",
                    vento: "12",
                    status: "Normal (Operação Padrão Sebinho)"
                };
            }
        }

        elements.chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = elements.userInput.value.trim();
            if (!text) return;

            appendMessage(text, 'user');
            elements.userInput.value = '';
            elements.chatContainer.scrollTop = elements.chatContainer.scrollHeight;

            elements.typingIndicator.classList.remove('hidden');

            const dadosClima = await consultarTelemetriaExterna();

            setTimeout(() => {
                elements.typingIndicator.classList.add('hidden');
                
                let respostaSarah = `🧠 **Gemini 3.6 • Varredura GOES-19 (Sebinho / Rocha Sobrinho):** Dados climáticos capturados ao vivo. Temperatura: ${dadosClima.temperatura}°C | Umidade: ${dadosClima.umidade}% | Ventos: ${dadosClima.vento} km/h. Bacia do Sarapuí sob supervisão contínua.`;
                
                const lower = text.toLowerCase();
                if(lower.includes('tempo') || lower.includes('chuva') || lower.includes('radar') || lower.includes('satelite')) {
                    respostaSarah = `🛰️ **Telemetria GOES-19 (Gemini 3.6):** O satélite confirma estabilidade na Baixada Fluminense. Condições atuais em Mesquita: ${dadosClima.temperatura}°C e ventos a ${dadosClima.vento} km/h. Toque em **Mapa GOES-19** na barra inferior para o painel ampliado!`;
                } else if(lower.includes('vento')) {
                    respostaSarah = `💨 **Monitoramento de Ventos:** Velocidade registrada de ${dadosClima.vento} km/h na região do Sebinho. Parâmetros seguros dentro da normalidade operacional.`;
                } else if(lower.includes('olá') || lower.includes('oi')) {
                    respostaSarah = `Olá! Tudo operando perfeitamente com o motor Gemini 3.6, avatar animado e tradução em Libras. Como posso ajudar?`;
                }

                appendMessage(respostaSarah, 'assistant');
                elements.chatContainer.scrollTop = elements.chatContainer.scrollHeight;
            }, 1000);
        });

        const robotSvgHtml = `<svg viewBox="0 0 500 500" class="w-full h-full"><style>@keyframes blink{0%,92%,100%{transform:scaleY(1)}96%{transform:scaleY(0.08)}}@keyframes speak{0%,100%{transform:scaleY(1)}50%{transform:scaleY(1.5)}}@keyframes pulse-antenna{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.7;transform:scale(1.1)}}.eye-anim{transform-origin:250px 175px;animation:blink 4s infinite ease-in-out}.mouth-anim{transform-origin:250px 210px;animation:speak 0.9s infinite ease-in-out}.antenna-dot{transform-origin:center;animation:pulse-antenna 2s infinite ease-in-out}</style><circle cx="250" cy="250" r="230" fill="#0f172a" stroke="#f97316" stroke-width="24"/><path d="M160,280 C160,250 180,240 250,240 C320,240 340,250 340,280 L340,360 C340,400 320,410 250,410 C180,410 160,400 160,360 Z" fill="#f97316"/><rect x="170" y="130" width="160" height="110" rx="35" fill="#0284c7"/><line x1="200" y1="130" x2="200" y2="90" stroke="#f97316" stroke-width="10" stroke-linecap="round"/><circle class="antenna-dot" cx="200" cy="80" r="10" fill="#f97316"/><line x1="300" y1="130" x2="300" y2="90" stroke="#f97316" stroke-width="10" stroke-linecap="round"/><circle class="antenna-dot" cx="300" cy="80" r="10" fill="#f97316" style="animation-delay: 1s;"/><rect x="150" y="165" width="20" height="45" rx="8" fill="#f97316"/><rect x="330" y="165" width="20" height="45" rx="8" fill="#f97316"/><g class="eye-anim"><circle cx="215" cy="175" r="14" fill="#f97316"/><circle cx="285" cy="175" r="14" fill="#f97316"/></g><g class="mouth-anim"><path d="M225,200 Q250,220 275,200" fill="none" stroke="#f97316" stroke-width="6" stroke-linecap="round"/></g><path d="M250,250 L320,280 L320,350 C320,390 250,420 250,420 C250,420 180,390 180,350 L180,280 Z" fill="#0284c7" stroke="#f97316" stroke-width="10"/></svg>`;

        function appendMessage(text, sender) {
            const isUser = sender === 'user';
            const wrapper = document.createElement('div');
            wrapper.className = `flex items-start space-x-3 max-w-2xl ${isUser ? 'ml-auto flex-row-reverse space-x-reverse' : ''} animate-fade-in`;
            
            const avatar = isUser 
                ? `<div class="w-8 h-8 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center shrink-0 text-slate-300 text-xs font-bold">EU</div>`
                : `<div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-orange-600 to-amber-400 flex items-center justify-center shrink-0 shadow-md overflow-hidden p-0.5">${robotSvgHtml}</div>`;

            const bubbleClass = isUser 
                ? 'bg-orange-600/90 text-white rounded-2xl rounded-tr-sm border border-orange-500/30' 
                : 'glass-panel text-slate-100 rounded-2xl rounded-tl-sm border border-orange-500/20';

            wrapper.innerHTML = `
                ${avatar}
                <div class="${bubbleClass} p-4 shadow-xl leading-relaxed text-xs sm:text-sm relative group">
                    <p>${text.replace(/\n/g, '<br>')}</p>
                </div>
            `;
            elements.chatContainer.appendChild(wrapper);
        }
    </script>
</body>
</html>
