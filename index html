<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Cidadão Censor - Sebinho AI</title>
    <meta name="theme-color" content="#0f172a">
    <meta name="description" content="Monitoramento de Desastres e Inteligência Artificial para a Comunidade do Sebinho & Bacia do Sarapuí">
    
    <link rel="icon" type="image/png" href="https://cdn-icons-png.flaticon.com/512/2921/2921226.png">
    <link rel="apple-touch-icon" href="https://cdn-icons-png.flaticon.com/512/2921/2921226.png">
    
    <link rel="manifest" href="data:application/json;base64,">

    <style>
        :root { 
            --bg: #0f172a; --glass: rgba(30, 41, 59, 0.85); 
            --accent: #38bdf8; --danger: #ef4444; --warning: #f59e0b;
            --text: #ffffff; --safe: #10b981; 
        }
        * { box-sizing: border-box; }
        body { 
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; 
            background: radial-gradient(circle at 50% 30%, #1e293b 0%, #0f172a 100%); 
            color: var(--text); height: 100dvh; width: 100vw; margin: 0; padding: 0; 
            display: flex; flex-direction: column; overflow: hidden; position: fixed; 
            font-size: 16px;
        }
        body.light-mode { 
            background: radial-gradient(circle at 50% 30%, #f1f5f9 0%, #cbd5e1 100%); 
            color: #0f172a; 
        }
        
        header { padding: 12px 18px; display: flex; justify-content: space-between; align-items: center; background: rgba(15, 23, 42, 0.98); backdrop-filter: blur(15px); border-bottom: 1px solid rgba(255,255,255,0.15); z-index: 10; flex-shrink: 0; }
        body.light-mode header { background: rgba(255, 255, 255, 0.98); border-bottom-color: rgba(0,0,0,0.15); }
        
        .logo { font-weight: 800; font-size: 1.1rem; display: flex; align-items: center; gap: 8px; letter-spacing: 1px; }
        .logo span { color: var(--accent); text-shadow: 0 0 10px var(--accent); }
        .header-actions { display: flex; gap: 10px; }
        .icon-btn { background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); color: white; width: 38px; height: 38px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.3s; font-size: 1.1rem; }
        .icon-btn:hover { background: var(--accent); color: #000; }
        body.light-mode .icon-btn { color: #0f172a; border-color: rgba(0,0,0,0.2); background: rgba(0,0,0,0.08); }

        #status-bar { text-align: center; padding: 10px 15px; font-weight: bold; background: rgba(0,0,0,0.5); font-size: 0.85rem; letter-spacing: 0.3px; flex-shrink: 0; }
        .status-safe { color: var(--safe); }
        .status-warning { color: var(--warning); animation: pulse 1s infinite; }
        .status-danger { color: var(--danger); animation: pulse 0.5s infinite; text-shadow: 0 0 10px var(--danger); }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }

        #avatar-container { flex: 1; display: flex; justify-content: center; align-items: center; position: relative; min-height: 0; padding: 10px; }
        .avatar-img { 
            width: 210px; height: 210px; max-height: 42vh; max-width: 42vh; border-radius: 50%; 
            background: url('https://cdn-icons-png.flaticon.com/512/4712/4712035.png') no-repeat center center; 
            background-size: cover; 
            box-shadow: 0 0 30px rgba(16, 185, 129, 0.4); 
            border: 4px solid var(--safe);
            position: relative; overflow: hidden;
            transition: all 0.5s ease;
        }
        .avatar-eyes {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 70px; height: 24px; pointer-events: none;
            display: flex; justify-content: space-between;
        }
        .eye { 
            width: 22px; height: 22px; background: var(--accent); border-radius: 50%; 
            opacity: 0.95; box-shadow: 0 0 12px var(--accent); 
            animation: blink 4s infinite; transform-origin: center; 
        }
        .eye.right { margin-left: 12px; }
        @keyframes blink { 
            0%, 90%, 100% { transform: scaleY(1); } 
            95% { transform: scaleY(0.1); } 
        }
        .mouth { position: absolute; bottom: 22%; left: 50%; transform: translateX(-50%); width: 40px; height: 10px; background: var(--accent); border-radius: 20px; opacity: 0; transition: opacity 0.2s, height 0.2s; }
        
        #log-area { height: 140px; flex-shrink: 0; overflow-y: auto; padding: 12px 18px; font-size: 0.95rem; background: rgba(0,0,0,0.4); border-top: 1px solid rgba(255,255,255,0.15); display: flex; flex-direction: column; gap: 10px; }
        body.light-mode #log-area { background: rgba(255,255,255,0.7); border-top-color: rgba(0,0,0,0.15); color: #0f172a; }
        .log-entry { padding: 10px 14px; border-radius: 12px; max-width: 92%; line-height: 1.5; word-break: break-word; }
        .log-user { align-self: flex-end; background: rgba(56, 189, 248, 0.25); border: 1px solid var(--accent); color: #ffffff; font-weight: 500; }
        body.light-mode .log-user { background: rgba(2, 132, 199, 0.15); color: #0369a1; border-color: #0284c7; }
        .log-bot { align-self: flex-start; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); color: #ffffff; }
        body.light-mode .log-bot { background: rgba(0,0,0,0.06); color: #0f172a; border-color: rgba(0,0,0,0.1); }
        .log-system { align-self: center; background: transparent; border: none; font-size: 0.8rem; color: #cbd5e1; text-align: center; }
        body.light-mode .log-system { color: #475569; }

        #controls { padding: 12px 18px env(safe-area-inset-bottom, 15px) 18px; background: rgba(15, 23, 42, 0.98); backdrop-filter: blur(15px); display: flex; flex-direction: column; gap: 10px; flex-shrink: 0; border-top: 1px solid rgba(255,255,255,0.15); }
        body.light-mode #controls { background: rgba(241, 245, 249, 0.98); border-top: 1px solid rgba(0,0,0,0.15); }
        
        .api-section { display: flex; gap: 8px; }
        .api-input { flex: 1; background: rgba(0,0,0,0.6); border: 1px dashed var(--accent); color: var(--accent); padding: 8px 12px; border-radius: 8px; font-size: 0.85rem; font-family: monospace; outline: none; }
        body.light-mode .api-input { background: rgba(255,255,255,0.9); color: #0369a1; border-color: #0284c7; }
        .api-save { background: var(--accent); color: #000; border: none; padding: 0 16px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 0.85rem; }

        .input-wrapper { display: flex; gap: 10px; align-items: center; }
        input[type="text"] { 
            flex: 1; padding: 12px 16px; border-radius: 25px; border: 2px solid rgba(255,255,255,0.2); 
            background: rgba(255,255,255,0.1); color: white; font-size: 1rem; outline: none; transition: 0.3s; 
        }
        body.light-mode input[type="text"] { background: rgba(0,0,0,0.06); color: #0f172a; border-color: rgba(0,0,0,0.2); }
        input[type="text"]:focus { border-color: var(--accent); background: rgba(255,255,255,0.15); }

        .btn-mic, .btn-send { width: 48px; height: 48px; border-radius: 50%; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.3s; flex-shrink: 0; font-size: 1.1rem; }
        .btn-mic { background: rgba(255,255,255,0.15); color: white; }
        body.light-mode .btn-mic { background: rgba(0,0,0,0.12); color: #0f172a; }
        .btn-mic.listening { background: var(--danger); color: white; box-shadow: 0 0 20px var(--danger); }
        .btn-send { background: linear-gradient(135deg, #0ea5e9, #2563eb); color: white; }

        #alert-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.95); z-index: 1000; display: none; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 30px; }
        #alert-overlay.active { display: flex; }
        .alert-title { font-size: 24px; font-weight: 900; margin-bottom: 15px; color: var(--danger); }
        .alert-msg { font-size: 15px; line-height: 1.6; margin-bottom: 25px; color: #fff; }
        .btn-close-alert { background: white; color: black; border: none; padding: 12px 35px; border-radius: 25px; font-weight: bold; cursor: pointer; }

        #install-btn-container { display: none; position: fixed; top: 12px; left: 50%; transform: translateX(-50%); z-index: 999; }
        #install-btn { background: #10b981; color: white; border: none; padding: 8px 18px; border-radius: 18px; font-weight: bold; cursor: pointer; font-size: 0.85rem; }
    </style>
</head>
<body>

    <header>
        <div class="logo">📡 CIDADÃO <span>SENSOR</span></div>
        <div class="header-actions">
            <button class="icon-btn" id="themeToggleBtn" onclick="toggleTheme()" title="Modo Noturno / Diurno">🌙</button>
            <button class="icon-btn" onclick="shareApp()" title="Compartilhar App">🔗</button>
        </div>
    </header>

    <div id="install-btn-container">
        <button id="install-btn" onclick="installApp()">Instalar PWA</button>
    </div>

    <div id="status-bar" class="status-safe">
        🟢 Calha Estável (Rua Amazonas ➔ Linha Férrea)
    </div>

    <div id="avatar-container">
        <div class="avatar-img" id="avatarImg">
            <div class="avatar-eyes">
                <div class="eye"></div>
                <div class="eye right"></div>
            </div>
            <div class="mouth" id="avatarMouth"></div>
        </div>
    </div>

    <div id="log-area">
        <div class="log-entry log-system">📍 Jurisdição: Rua Amazonas (Leito do Rio) até Linha Férrea — Confluência Rio Dona Eugênia / Sarapuí</div>
        <div class="log-entry log-bot"><strong>Sarah:</strong> Conectada. Monitorando o trecho crítico na Rua Amazonas. Digite ou fale abaixo.</div>
    </div>

    <div id="controls">
        <div class="api-section" id="apiSection">
            <input type="password" id="apiKeyInput" placeholder="Cole sua Chave API Gemini (AI Studio)" class="api-input">
            <button class="api-save" onclick="saveApiKey()">Salvar</button>
        </div>
        <div class="input-wrapper">
            <button class="btn-mic" id="micBtn" onclick="toggleVoice()" title="Falar">🎤</button>
            <input type="text" id="userInput" placeholder="Digite sua mensagem..." autocomplete="off">
            <button class="btn-send" onclick="sendMessage()" title="Enviar">➤</button>
        </div>
    </div>

    <div id="alert-overlay">
        <div class="alert-title">⚠️ ALERTA DE RISCO NA CALHA</div>
        <div class="alert-msg" id="alertMsg">Elevação rápida detectada no trecho crítico.</div>
        <button class="btn-close-alert" onclick="closeAlert()">Compreendido</button>
    </div>

<script>
let deferredPrompt = null;
let recognition = null;
let isListening = false;

window.addEventListener('DOMContentLoaded', () => {
    const savedKey = localStorage.getItem('gemini_api_key');
    if (savedKey) {
        document.getElementById('apiKeyInput').value = savedKey;
        document.getElementById('apiSection').style.display = 'none';
    }

    monitorarDadosAbertos();
    setInterval(monitorarDadosAbertos, 600000);

    document.getElementById('userInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            sendMessage();
        }
    });

    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        recognition = new SpeechRecognition();
        recognition.lang = 'pt-BR';
        recognition.continuous = false;
        recognition.interimResults = false;
        
        recognition.onresult = (e) => {
            const transcript = e.results[0][0].transcript;
            document.getElementById('userInput').value = transcript;
            stopVoice();
            sendMessage();
        };
        recognition.onerror = () => stopVoice();
        recognition.onend = () => stopVoice();
    }
});

async function monitorarDadosAbertos() {
    const lat = -22.7833;
    const lon = -43.4333;
    const avatarImg = document.getElementById('avatarImg');
    
    try {
        const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,precipitation`);
        const data = await res.json();
        const temp = data.current.temperature_2m;
        const chuva = data.current.precipitation;
        
        const bar = document.getElementById('status-bar');
        if (chuva > 12) {
            bar.className = "status-bar status-danger";
            bar.innerHTML = `⚠️ ALERTA TRECHO CRÍTICO (Rua Amazonas / Linha Férrea): ${chuva} mm/h`;
            avatarImg.style.borderColor = "var(--danger)";
            avatarImg.style.boxShadow = "0 0 35px var(--danger)";
            showAlert("⚠️ ALERTA DE PRECIPITAÇÃO INTENSA NA CALHA", `Precipitação de ${chuva} mm/h. Alto risco de subida rápida na ponte de entrada (Rua Amazonas) e confluência do Dona Eugênia com o Sarapuí.`);
        } else if (chuva > 4) {
            bar.className = "status-bar status-warning";
            bar.innerHTML = `⚠️ Atenção Chuva: ${chuva} mm/h | Monitorando Rua Amazonas`;
            avatarImg.style.borderColor = "var(--warning)";
            avatarImg.style.boxShadow = "0 0 25px var(--warning)";
        } else {
            bar.className = "status-bar status-safe";
            bar.innerHTML = `🟢 Calha Estável (Rua Amazonas ➔ Linha Férrea) — Temp: ${temp}°C | Chuva: ${chuva} mm/h`;
            avatarImg.style.borderColor = "var(--safe)";
            avatarImg.style.boxShadow = "0 0 25px rgba(16, 185, 129, 0.4)";
        }
    } catch (e) {
        console.warn("Falha ao buscar dados climáticos abertos.");
    }
}

window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    document.getElementById('install-btn-container').style.display = 'block';
});

function installApp() {
    if (deferredPrompt) {
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then(() => { document.getElementById('install-btn-container').style.display = 'none'; });
    }
}

function saveApiKey() {
    const val = document.getElementById('apiKeyInput').value.trim();
    if (!val) {
        alert('Digite uma chave válida.');
        return;
    }
    localStorage.setItem('gemini_api_key', val);
    document.getElementById('apiSection').style.display = 'none';
    addLog('Sistema', 'Chave de API salva com sucesso!');
}

function toggleTheme() {
    document.body.classList.toggle('light-mode');
    const isLight = document.body.classList.contains('light-mode');
    document.getElementById('themeToggleBtn').textContent = isLight ? '☀️' : '🌙';
}

function shareApp() {
    if (navigator.share) {
        navigator.share({ title: 'Cidadão Censor - Sebinho AI', url: window.location.href }).catch(() => {});
    } else {
        navigator.clipboard.writeText(window.location.href).then(() => alert('Link copiado!'));
    }
}

function toggleVoice() {
    if (!recognition) {
        alert('Reconhecimento de voz não suportado neste navegador.');
        return;
    }
    if (!isListening) {
        try {
            recognition.start();
            isListening = true;
            document.getElementById('micBtn').classList.add('listening');
        } catch(e) {
            stopVoice();
        }
    } else {
        recognition.stop();
        stopVoice();
    }
}

function stopVoice() {
    isListening = false;
    const mic = document.getElementById('micBtn');
    if(mic) mic.classList.remove('listening');
}

function addLog(sender, text) {
    const area = document.getElementById('log-area');
    const div = document.createElement('div');
    div.className = `log-entry ${sender === 'Eu' ? 'log-user' : (sender === 'Sistema' ? 'log-system' : 'log-bot')}`;
    div.innerHTML = sender !== 'Eu' && sender !== 'Sistema' ? `<strong>${sender}:</strong> ${text}` : text;
    area.appendChild(div);
    area.scrollTop = area.scrollHeight;
}

async function sendMessage() {
    const input = document.getElementById('userInput');
    const q = input.value.trim();
    if (!q) return;

    const apiKey = localStorage.getItem('gemini_api_key') || document.getElementById('apiKeyInput').value.trim();
    if (!apiKey) {
        alert('Por favor, insira e salve sua chave de API do Gemini.');
        document.getElementById('apiSection').style.display = 'flex';
        return;
    }

    addLog('Eu', q);
    input.value = '';
    
    document.getElementById('avatarMouth').style.opacity = '1';

    try {
        const systemPrompt = `Você é a Sarah, assistente técnica de Defesa Civil Comunitária da Comunidade Sebinho, focada no trecho crítico compreendido na Rua Amazonas (leito do rio), passando pela ponte de entrada e a confluência do Rio Dona Eugênia com o Rio Sarapuí, estendendo-se até a linha férrea. Responda de forma objetiva, técnica e preventiva: ${q}`;

        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contents: [{ parts: [{ text: systemPrompt }] }] })
        });
        
        const data = await res.json();
        document.getElementById('avatarMouth').style.opacity = '0';

        if (data.error) {
            throw new Error(data.error.message || 'Erro na API');
        }

        let ans = data?.candidates?.[0]?.content?.parts?.[0]?.text || "Sem resposta retornada.";
        addLog('Sarah', ans);
    } catch (e) {
        document.getElementById('avatarMouth').style.opacity = '0';
        addLog('Sistema', `Erro na IA: ${e.message}`);
    }
}

function showAlert(title, msg) {
    document.querySelector('.alert-title').textContent = title;
    document.getElementById('alertMsg').textContent = msg;
    document.getElementById('alert-overlay').classList.add('active');
}

function closeAlert() {
    document.getElementById('alert-overlay').classList.remove('active');
}
</script>
</body>
</html>
